# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8900
BACKEND_LOG_LEVEL=info

# Database (SQLite file; ADR 0004)
DATABASE_URL=sqlite+aiosqlite:///./tuk_tuk.db

# Secrets
# SECRET_KEY: session signing key. In prod this is a long random value
# generated once and stored in 1Password (see backend/chart/README.md) —
# never generated at container start.
SECRET_KEY=change-me
# ADMIN_PASSWORD_HASH: PLACEHOLDER until the auth gate is implemented (#78).
ADMIN_PASSWORD_HASH=PLACEHOLDER-REPLACE-BEFORE-GO-LIVE

# ---- Frontend ----
# Empty = same-origin; the Vite dev server proxies /api to the backend, so the
# app works from localhost, a LAN / tailnet address or a tunnel alike. Set an
# absolute URL only when the API is served from a different origin.
VITE_API_BASE_URL=
