# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8900
BACKEND_LOG_LEVEL=info

# Database: PostgreSQL only (ADR 0017). Required — the backend refuses to
# start without it. `docker compose up` ignores this value and points the
# backend at its own `postgres` service; this one is for running the
# backend outside Docker against that same service (published on 5433).
DATABASE_URL=postgresql+psycopg://tuktuk:tuktuk@localhost:5433/tuktuk

# Authentication (ADR 0005/0008/0018). Passwords live on each user in the
# database and the session signing key in the DB-backed `settings` table,
# not here — a fresh deployment creates its first admin from the app's own
# `/setup` screen on first boot, no env var required.
# APP_MASTER_KEY: encrypts sensitive columns of that `settings` table (the
# Google client secret) and stored Google refresh tokens. The app refuses
# to start without it — generate your own with `openssl rand -base64 32`.
# In prod this is a long random value generated once and stored in
# 1Password (see backend/chart/README.md), never generated at container
# start.
APP_MASTER_KEY=
# Off for plain-HTTP LAN/tailnet dev; on in the cluster.
AUTH_COOKIE_SECURE=false
# Which kind of deployment this is: `development` or `production`. Anything
# but an explicit `development` (including leaving it unset) is production.
APP_ENV=development
# Local-dev only: no login or cookie needed, every request acts as the first
# admin. The backend refuses to start with it unless APP_ENV=development.
AUTH_DISABLED=false

# AUTH_PASSWORD_HASH, GOOGLE_CLIENT_ID, and GOOGLE_CLIENT_SECRET below are
# migration-only: consulted once, on an existing deployment's first boot
# after upgrading, to import that deployment's password (onto user #1) and
# Google connection (onto the first user's settings) so upgrading doesn't
# log the owner out or disconnect Google. A fresh deployment leaves all
# three unset — it creates its admin via `/setup` and, later, sets Google
# credentials via Settings (issue #117) instead. Once imported, these env
# vars are never read again.
AUTH_PASSWORD_HASH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Invite-only Google sign-in (issue #586, ADR 0021). Operator-managed and
# never shown in the app. Both set turns on Google sign-in, invitations, and
# Google Calendar through this one client for every User. Unrelated to the
# migration-only GOOGLE_CLIENT_ID/SECRET above. See
# docs/self-hosting/google-sign-in.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Where invitation links point; defaults to the first CORS_ORIGINS entry.
APP_PUBLIC_URL=
# Invitation email. Unset SMTP_HOST: invitations are created but not
# emailed, and an Admin copies each link. SMTP_SECURITY is starttls (587)
# or ssl (465); "none" is refused outside APP_ENV=development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Assist (ADR 0005, v2). Migration-only, like AUTH_PASSWORD_HASH/GOOGLE_*
# above: imported into `settings` once, on an existing deployment's first
# boot, so upgrading doesn't require re-entering config already set. A
# fresh deployment leaves both unset and configures Assist from Settings
# instead — every affordance stays invisible until it's turned on there.
ASSIST_OLLAMA_BASE_URL=
ASSIST_MODEL=

# ---- Frontend ----
# Empty = same-origin; the Vite dev server proxies /api to the backend, so the
# app works from localhost, a LAN / tailnet address or a tunnel alike. Set an
# absolute URL only when the API is served from a different origin.
VITE_API_BASE_URL=
