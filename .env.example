# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8900
BACKEND_LOG_LEVEL=info

# Database (SQLite file; ADR 0004)
DATABASE_URL=sqlite+aiosqlite:///./tuk_tuk.db

# Authentication (ADR 0005).
# SECRET_KEY: session signing key. The app refuses to start while this is
# left at the placeholder "change-me" — generate your own dev value with
# `openssl rand -base64 32`. In prod this is a long random value generated
# once and stored in 1Password (see backend/chart/README.md), never
# generated at container start.
SECRET_KEY=change-me
# AUTH_PASSWORD_HASH below is the Argon2id hash of "dev-password" — fine for
# local/LAN/tailnet dev, replace before deploying. Generate your own with
# `mise run backend:hash-password`.
AUTH_PASSWORD_HASH=$argon2id$v=19$m=262144,t=5,p=4$gW0FE3bPYYKlvORftthHrg$LkWUP5wGzIzKcAMmX1F1K3cOj+kw5GmegTzmHhonygk
# Off for plain-HTTP LAN/tailnet dev; on in the cluster.
AUTH_COOKIE_SECURE=false

# Google Calendar integration (issue #103; ADR 0006). Both empty by
# default, which disables the feature entirely: with no GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET, the app runs normally and shows no Google Calendar
# section or wording anywhere — same as any fresh clone or CI run. Set both
# to enable it; get them from a Google Cloud OAuth client with an exact
# redirect URI registered for each origin you use it from, and publishing
# status "In production" (test-user refresh credentials on an unverified app
# expire after seven days).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_ENCRYPTION_KEY (issue #105): encrypts stored Google refresh
# credentials at rest. Required once GOOGLE_CLIENT_ID/SECRET are set — the
# app refuses to start otherwise. Deliberately separate from SECRET_KEY so
# that rotating the session signing key (which logs every device out) never
# destroys a connected Google account. Generate with `openssl rand -base64 32`.
GOOGLE_ENCRYPTION_KEY=

# ---- Frontend ----
# Empty = same-origin; the Vite dev server proxies /api to the backend, so the
# app works from localhost, a LAN / tailnet address or a tunnel alike. Set an
# absolute URL only when the API is served from a different origin.
VITE_API_BASE_URL=
