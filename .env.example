# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8900
BACKEND_LOG_LEVEL=info

# Database (SQLite file; ADR 0004)
DATABASE_URL=sqlite+aiosqlite:///./tuk_tuk.db

# Authentication (ADR 0005/0008). The login password and the session
# signing key live in the DB-backed `settings` table now, not here — a
# fresh deployment sets its password from the app's own `/setup` screen on
# first boot, no env var required.
# APP_MASTER_KEY: encrypts sensitive columns of that `settings` table (the
# Google client secret) and stored Google refresh tokens. The app refuses
# to start without it — generate your own with `openssl rand -base64 32`.
# In prod this is a long random value generated once and stored in
# 1Password (see backend/chart/README.md), never generated at container
# start.
APP_MASTER_KEY=
# Off for plain-HTTP LAN/tailnet dev; on in the cluster.
AUTH_COOKIE_SECURE=false

# AUTH_PASSWORD_HASH, GOOGLE_CLIENT_ID, and GOOGLE_CLIENT_SECRET below are
# migration-only: consulted once, on an existing deployment's first boot
# after upgrading, to import that deployment's password and Google
# connection into `settings` so upgrading doesn't log the owner out or
# disconnect Google. A fresh deployment leaves all three unset — it sets a
# password via `/setup` and, later, Google credentials via Settings
# (issue #117) instead. Once imported, these env vars are never read again.
AUTH_PASSWORD_HASH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Frontend ----
# Empty = same-origin; the Vite dev server proxies /api to the backend, so the
# app works from localhost, a LAN / tailnet address or a tunnel alike. Set an
# absolute URL only when the API is served from a different origin.
VITE_API_BASE_URL=
